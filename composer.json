{
    "name": "enjoyscms/admin",
    "description": "Module Admin for EnjoysCMS",
    "type": "enjoyscms-module",
    "require": {
        "php": "^8.3",
        "enjoyscms/core": "^7.0@dev",
        "enjoys/forms": "^5.0",
        "enjoys/bootstrap4-renderer": "^1.0",
        "yiisoft/validator": "^2.2.0",
        "yiisoft/hydrator-validator": "^2.0",
        "jms/serializer": "^3.32.3"
    },
    "autoload": {
        "psr-4": {
            "EnjoysCMS\\Module\\Admin\\": "src/",
            "EnjoysCMS\\Module\\Admin\\Widgets\\": "widgets/",
            "EnjoysCMS\\Module\\Admin\\Composer\\Scripts\\": "scripts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\EnjoysCMS\\Module\\Admin\\": "tests/"
        }
    },
    "extra": {
        "module-name": "Admin panel"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/var-dumper": "^7.2"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true
        }
    }
}
